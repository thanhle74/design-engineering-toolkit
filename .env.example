# DET Studio — local environment template (copied to .env.local; .env.local is gitignored).
# All variables are OPTIONAL: Studio runs without any of them (fixture DEMO mode,
# no persistence). Relative paths resolve against the repository root when the
# app is launched through the root launcher (`pnpm run dev` / `pnpm run start`,
# see scripts/studio.mjs). Next.js loads .env.local for both dev and start.

# [50] Catalogue persistence: enables the SQLite catalogue (projects, runs,
# artifact metadata). Unset = no DB anywhere. The DB lands at
# <STUDIO_DATA_DIR>/studio.sqlite (created on first use via the committed
# versioned migrations in src/modules/studio/server/catalog/migrations.ts).
STUDIO_DATA_DIR=./data

# [40] Where finished det build bundles land (one subdirectory per run).
# Required by the build runner; the root launcher defaults it to
# out/studio-runs (created on demand) when unset.
#STUDIO_DET_RUNS_DIR=out/studio-runs

# Extra local build-config catalogue entries (one subdirectory per entry
# with a build-config.json). Unset = only the committed repository examples.
#STUDIO_BUILD_PROJECTS_DIR=

# Which det CLI the build runner spawns (default: ../../bin/det.js relative
# to the Studio module dir, i.e. this checkout's root bin/det.js).
#STUDIO_DET_CLI=

# Build timeout in milliseconds (default 120000).
#STUDIO_BUILD_TIMEOUT_MS=120000

# [65] Local Claude Code agent lane. Timeout ms (default 900000), per-run
# budget in USD (default "2"), and the CLI binary name on PATH (default
# "claude"). No server ever captures credentials or installs anything.
#STUDIO_AGENT_TIMEOUT_MS=900000
#STUDIO_AGENT_MAX_BUDGET_USD=2
#STUDIO_CLAUDE_CLI=claude

# Server port (Next default 3000).
#PORT=3000
