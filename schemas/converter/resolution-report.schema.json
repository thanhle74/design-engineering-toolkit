{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/thanhle74/design-engineering-toolkit/main/schemas/converter/resolution-report.schema.json",
  "$comment": "Design Engineering Toolkit converter family — ResolutionReport. Major version 1. Deterministic, evidence-carrying outcome of resolving a structure against a pinned registry + binding map: per-section status, candidates/selected capability, unsupported reasons, confidence, coverage. For identical pinned inputs, two runs produce byte-identical canonical payloads (content hash excludes generatedAt). This payload is an intermediate artifact — it is never a platform serialization and never stored as raw content.",
  "title": "Design Engineering Toolkit — Resolution Report",
  "type": "object",
  "required": ["schemaVersion", "profileId", "platformId", "generatedAt", "inputs", "sections", "coverage", "counts", "proofStatus", "diagnostics"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "$ref": "common.defs.json#/$defs/schemaVersionMajor" },
    "profileId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "platformId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "generatedAt": { "type": "string", "format": "date-time", "description": "Excluded from the content hash." },
    "inputs": {
      "type": "object",
      "required": ["registryRevisionId"],
      "additionalProperties": false,
      "properties": {
        "registryRevisionId": { "type": "string", "minLength": 1 },
        "bindingMapContentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 over the canonical form of the binding map (minus generatedAt)." },
        "nodeIrContentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Populated from G2 onward." },
        "pageStructureContentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Populated from G2 onward; G1 uses the harness structure fixture's canonical hash." }
      },
      "description": "Exactly which inputs produced this report — reproducibility pin."
    },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/sectionReport" },
      "description": "Sorted by (order, sectionId)."
    },
    "coverage": {
      "type": "object",
      "required": ["native", "widget", "chrome", "custom-required", "unsupported", "total"],
      "additionalProperties": false,
      "properties": {
        "native": { "type": "integer", "minimum": 0 },
        "widget": { "type": "integer", "minimum": 0 },
        "chrome": { "type": "integer", "minimum": 0 },
        "custom-required": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      },
      "description": "Counts of selected capabilities by registry category; total = number of resolved elements."
    },
    "counts": {
      "type": "object",
      "required": ["errors", "warnings", "infos"],
      "additionalProperties": false,
      "properties": {
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "infos": { "type": "integer", "minimum": 0 }
      },
      "description": "Computed from diagnostics. The semantic validator asserts consistency."
    },
    "proofStatus": {
      "type": "object",
      "required": ["maxClaimedProofLevel", "maxJustifiedProofLevel"],
      "additionalProperties": false,
      "properties": {
        "maxClaimedProofLevel": { "$ref": "common.defs.json#/$defs/proofLevel" },
        "maxJustifiedProofLevel": { "$ref": "common.defs.json#/$defs/proofLevel" }
      },
      "description": "Inequality is a hard reject (EVIDENCE_MISSING): the payload is rejected, not silently downgraded."
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "common.defs.json#/$defs/diagnostic" }
    }
  },
  "$defs": {
    "sectionReport": {
      "type": "object",
      "required": ["sectionId", "order", "status", "candidates", "selected", "unsupportedReasons", "mappingConfidence", "proofLevel", "evidence"],
      "additionalProperties": false,
      "properties": {
        "sectionId": { "type": "string", "pattern": "^s-[0-9a-f]{12}$" },
        "order": { "type": "integer", "minimum": 0, "description": "Document position; unique across sections." },
        "name": { "type": "string" },
        "status": {
          "enum": ["mapped", "partially-mapped", "unmapped", "blocked"],
          "description": "Closed enum. 'blocked' iff >=1 error-severity diagnostic names the section."
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["capabilityId", "appearanceId", "confidence"],
            "additionalProperties": false,
            "properties": {
              "capabilityId": { "$ref": "common.defs.json#/$defs/capabilityId" },
              "appearanceId": { "$ref": "common.defs.json#/$defs/appearanceId" },
              "confidence": { "$ref": "common.defs.json#/$defs/mappingConfidence" }
            }
          },
          "description": "Sorted by (capabilityId, appearanceId)."
        },
        "selected": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["capabilityId", "appearanceId"],
              "additionalProperties": false,
              "properties": {
                "capabilityId": { "$ref": "common.defs.json#/$defs/capabilityId" },
                "appearanceId": { "$ref": "common.defs.json#/$defs/appearanceId" }
              }
            }
          ]
        },
        "unsupportedReasons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message"],
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
              "message": { "type": "string", "minLength": 1 },
              "evidence": { "$ref": "common.defs.json#/$defs/sourceEvidence" }
            }
          },
          "description": "Sorted by code."
        },
        "mappingConfidence": { "$ref": "common.defs.json#/$defs/mappingConfidence" },
        "proofLevel": { "$ref": "common.defs.json#/$defs/proofLevel" },
        "evidence": { "type": "array", "items": { "$ref": "common.defs.json#/$defs/sourceEvidence" }, "description": "May be empty for unmapped sections." }
      }
    }
  }
}
