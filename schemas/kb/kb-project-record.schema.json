        "mitigation": { "type": "string" },
        "triggerCondition": { "type": "string" },
        "linkedGate": { "type": "string" }
      }
    },
    {
      "$comment": "open-question",
      "required": ["recordType", "status", "question"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/f-schemaVersion" },
        "recordType": { "const": "open-question" },
        "id": { "type": "string", "pattern": "^oq:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*$" },
        "projectId": { "$ref": "#/$defs/f-projectId" },
        "tenantId": { "$ref": "#/$defs/f-tenantId" },
        "environment": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "statement": { "type": "string" },
