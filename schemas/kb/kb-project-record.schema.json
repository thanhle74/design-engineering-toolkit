        "title": { "type": "string", "minLength": 1 },
        "statement": { "type": "string" },
        "rationale": { "type": "string" },
        "owner": { "type": "string" },
        "source": { "type": "object" },
        "status": { "enum": ["requested", "attested", "approved", "withdrawn"] },
        "version": { "type": "integer", "minimum": 1 },
        "supersedes": { "type": "array", "items": { "type": "string" } },
        "supersededBy": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "visibility": { "enum": ["private", "sanitized", "example"] },
        "evidence": { "type": "object" },
        "lifecycle": { "type": "object" },
        "observed": { "type": "object" },
        "diagnostics": { "type": "array" },
        "notes": { "type": "string" },
        "approvedBy": { "type": "string" },
        "approvalRef": { "type": ["string", "null"] },
        "approvalDate": { "type": ["string", "null"], "format": "date-time" },
        "channel": { "enum": ["github-record", "issue-text", "in-session-verbal"] },
        "durability": { "enum": ["recorded", "attested"] },
        "subject": { "type": "string" }
      }
    },
    {
      "$comment": "risk",
      "required": ["recordType", "status", "likelihood", "impact"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/f-schemaVersion" },
        "recordType": { "const": "risk" },
        "id": { "type": "string", "pattern": "^risk:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*$" },
