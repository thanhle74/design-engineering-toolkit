{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/thanhle74/design-engineering-toolkit/main/schemas/kb/kb-project-record.schema.json",
  "$comment": "Knowledge Engine — KB-3 (Project Knowledge) record. Frozen at major 1 from the reviewed issue #7 draft, with TWO documented freeze adjustments (schemas/kb/README.md): (1) the per-type branch fields were restructured so ajv actually validates instances — the draft's oneOf branches declared type fields outside the root additionalProperties:false scope, which would have rejected every instance carrying them; each branch now fully enumerates its allowed fields; (2) lifecycle + observed are required on every KB-3 record so the unified record envelope (digest-pinned sync, review status, staleness) holds for all three KBs. TENANT-ISOLATED BY STRUCTURE: projectId + tenantId are mandatory on every record; there is no field state that means 'all projects'. Public-toolkit material must be visibility: example. External requirement IDs (LC/FC/LA/Jira) live ONLY in externalRef — they are never canonical ids.",
  "title": "Knowledge Engine — KB-3 Project record",
  "type": "object",
  "required": ["schemaVersion", "recordType", "id", "projectId", "tenantId", "title", "statement", "status", "visibility", "source", "createdAt", "lifecycle", "observed"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "$ref": "#/$defs/f-schemaVersion" },
    "recordType": { "enum": ["requirement", "ux-intent", "composition", "decision", "approval", "risk", "open-question", "constraint", "source-document"] },
    "id": {
      "type": "string",
      "pattern": "^(req|uxi|cmp|dec|apr|risk|oq|con|src):[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*$",
      "$comment": "'<prefix>:<project-slug>:<kebab-slug>'; project slug MUST equal projectId (enforced by the KB validator and partition layout)."
    },
    "projectId": { "$ref": "#/$defs/f-projectId" },
    "tenantId": { "$ref": "#/$defs/f-tenantId" },
    "environment": { "type": "string", "$comment": "Optional scope, e.g. 'local', 'staging'. Never a secret-bearing value." },
    "title": { "type": "string", "minLength": 1 },
    "statement": { "type": "string", "$comment": "The atomic sentence this record asserts." },
    "rationale": { "type": "string" },
    "owner": { "type": "string", "$comment": "Role or person reference. Person names in public exports must reduce to roles." },
    "source": {
      "type": "object",
      "required": ["kind", "locator"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["figma-file", "github-issue", "spec", "audit-doc", "decision-record", "state-json", "profile", "ticket", "approved-notes"] },
        "locator": { "type": "string", "$comment": "Path (rootAlias-relative), URL, or fileKey:nodeId. Absolute owner paths are unrepresentable in shared stores." },
        "quote": { "type": "string", "maxLength": 500, "$comment": "Short factual quote from project-owned documents only — never from licensed vendor material." },
        "accessedAt": { "type": "string", "format": "date-time" }
      }
    },
    "status": { "type": "string", "$comment": "Per-recordType enum — enforced in the oneOf branches below." },
    "version": { "type": "integer", "minimum": 1, "$comment": "Monotonic. Substantive change = new version + supersedes pointer (append-immutable); metadata fixes may bump in place." },
    "supersedes": { "type": "array", "items": { "type": "string" } },
    "supersededBy": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "visibility": { "enum": ["private", "sanitized", "example"], "$comment": "private = tenant-only; sanitized = client token stripped; example = synthetic, eligible for the public toolkit. Only 'example' may be promoted to the public toolkit (ingest visibilityPolicy enforces this)." },
    "evidence": { "$ref": "#/$defs/evidence" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "observed": { "$ref": "#/$defs/observed" },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "notes": { "type": "string" },
    "kind": { "enum": ["functional", "aesthetic", "content", "legal", "performance", "infrastructure"] },
    "externalRef": {
      "type": "object",
      "required": ["system", "id"],
      "additionalProperties": false,
      "properties": {
        "system": { "type": "string", "$comment": "e.g. 'ba-checklist', 'jira', 'linear' — the external system, never treated as canonical." },
        "id": { "type": "string", "$comment": "e.g. 'LC-03'. Provisional until anchored: traceStatus must say so." }
      }
    },
    "traceStatus": { "enum": ["TRACED", "INFERRED_FROM_ARTIFACT", "UNKNOWN"], "$comment": "UNKNOWN requires a linked open-question record — never silently inferred." },
    "ac": { "type": "array", "items": { "type": "string" }, "$comment": "Acceptance criteria." },
    "maturity": { "enum": ["VERIFIED_WORKING", "BUILT_UNVERIFIED", "IN_PROGRESS", "PLANNED", "ABSENT", "unknown"], "$comment": "Runtime maturity vocabulary adopted from the audited project's own design-feature-matrix gate." },
    "page": { "type": "string" },
    "breakpoints": { "type": "array", "items": { "type": "integer", "minimum": 320 } },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "desktop": { "type": "string" },
        "mobile": { "type": "string" }
      }
    },
    "priority": { "enum": ["must", "should", "could", "excluded"] },
    "contentPolicy": { "enum": ["fixture", "real", "conditional"] },
    "renderOwnerIntent": { "type": "string", "$comment": "e.g. 'theme', 'cms-block', 'native-pb', 'widget:banner_a', 'composition-pattern'. Intent, not evidence — the resolved capability lives in relation records." },
    "dataOwner": { "enum": ["cms", "catalog", "config", "newsletter", "none", "unknown"] },
    "uxIntentRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^uxi:" } },
    "componentRefs": {
      "type": "array",
      "$comment": "External refs by id + versionPin only — never copies of KB-1/KB-2 records.",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^(uic|cap):" },
          "versionPin": { "type": "string" },
          "variant": { "type": "string" }
        }
      }
    },
    "optionsConsidered": { "type": "array", "items": { "type": "string" } },
    "chosen": { "type": "string" },
    "decidedBy": { "type": "string", "$comment": "Role reference; names reduce to roles in public exports." },
    "decidedAt": { "type": "string", "format": "date-time" },
    "reversibility": { "enum": ["cheap", "costly", "irreversible"] },
    "approvedBy": { "type": "string" },
    "approvalRef": { "type": ["string", "null"], "$comment": "Issue/PR/comment URL. 'attested' approvals have a real human go but no durable record — they do NOT satisfy approval-demanding gates." },
    "approvalDate": { "type": ["string", "null"], "format": "date-time" },
    "channel": { "enum": ["github-record", "issue-text", "in-session-verbal"] },
    "durability": { "enum": ["recorded", "attested"] },
    "subject": { "type": "string", "$comment": "What exactly was approved." },
    "likelihood": { "enum": ["low", "medium", "high"] },
    "impact": { "enum": ["low", "medium", "high"] },
    "mitigation": { "type": "string" },
    "triggerCondition": { "type": "string" },
    "linkedGate": { "type": "string", "$comment": "e.g. 'G5', 'S4'." },
    "question": { "type": "string" },
    "blockingWhat": { "type": "string", "$comment": "Gate/stage this blocks, if any." },
    "resolutionRef": { "type": ["string", "null"], "$comment": "Decision/approval id that resolved it." },
    "strength": { "enum": ["invariant", "default"], "$comment": "invariant = cannot be overridden by any profile (V1 safety §1 semantics); default = may be tightened, never loosened." },
    "enforcement": { "enum": ["fail-closed", "schema", "ci", "convention"] },
    "scope": { "type": "string" },
    "docKind": { "enum": ["figma-file", "github-issue", "spec", "audit-doc", "decision-record", "state-json", "profile", "ticket"] },
    "locator": { "type": "string" },
    "versionPin": { "type": "string", "$comment": "V1 pin semantics: accessedAt (+ content digest where available)." },
    "classification": { "enum": ["first-party", "client-proprietary", "external"] },
    "sanitizationStatus": { "enum": ["raw", "sanitized", "example-only"] },
    "mayPromoteToPublicToolkit": { "type": "boolean", "$comment": "true requires visibility: example AND sanitizationStatus != raw." }
  },
  "oneOf": [
    {
      "$comment": "requirement",
      "required": ["recordType", "status", "kind", "traceStatus"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/f-schemaVersion" },
        "recordType": { "const": "requirement" },
        "id": { "type": "string", "pattern": "^req:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*$" },
        "projectId": { "$ref": "#/$defs/f-projectId" },
        "tenantId": { "$ref": "#/$defs/f-tenantId" },
        "environment": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "statement": { "type": "string" },
        "rationale": { "type": "string" },
        "owner": { "type": "string" },
        "source": { "type": "object" },
        "status": { "enum": ["draft", "proposed", "approved", "implemented", "verified", "superseded", "dropped"] },
        "version": { "type": "integer", "minimum": 1 },
        "supersedes": { "type": "array", "items": { "type": "string" } },
        "supersededBy": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "visibility": { "enum": ["private", "sanitized", "example"] },
        "evidence": { "type": "object" },
        "lifecycle": { "type": "object" },
        "observed": { "type": "object" },
        "diagnostics": { "type": "array" },
        "notes": { "type": "string" },
        "kind": { "$ref": "#/$defs/f-reqKind" },
        "externalRef": { "type": "object" },
        "traceStatus": { "enum": ["TRACED", "INFERRED_FROM_ARTIFACT", "UNKNOWN"] },
        "ac": { "type": "array", "items": { "type": "string" } },
        "maturity": { "enum": ["VERIFIED_WORKING", "BUILT_UNVERIFIED", "IN_PROGRESS", "PLANNED", "ABSENT", "unknown"] }
      }
    },
    {
      "$comment": "ux-intent",
      "required": ["recordType", "status", "page"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/f-schemaVersion" },
        "recordType": { "const": "ux-intent" },
        "id": { "type": "string", "pattern": "^uxi:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*$" },
        "projectId": { "$ref": "#/$defs/f-projectId" },
        "tenantId": { "$ref": "#/$defs/f-tenantId" },
        "environment": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "statement": { "type": "string" },
        "rationale": { "type": "string" },
        "owner": { "type": "string" },
        "source": { "type": "object" },
        "status": { "enum": ["candidate", "approved", "composed", "superseded"] },
        "version": { "type": "integer", "minimum": 1 },
        "supersedes": { "type": "array", "items": { "type": "string" } },
        "supersededBy": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "visibility": { "enum": ["private", "sanitized", "example"] },
        "evidence": { "type": "object" },
        "lifecycle": { "type": "object" },
        "observed": { "type": "object" },
        "diagnostics": { "type": "array" },
        "notes": { "type": "string" },
        "page": { "type": "string" },
        "breakpoints": { "type": "array", "items": { "type": "integer", "minimum": 320 } },
        "behavior": { "type": "object" },
        "priority": { "enum": ["must", "should", "could", "excluded"] },
        "contentPolicy": { "enum": ["fixture", "real", "conditional"] },
        "renderOwnerIntent": { "type": "string" },
        "dataOwner": { "enum": ["cms", "catalog", "config", "newsletter", "none", "unknown"] }
      }
    },
    {
      "$comment": "composition",
      "required": ["recordType", "status", "uxIntentRefs", "componentRefs"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/f-schemaVersion" },
        "recordType": { "const": "composition" },
        "id": { "type": "string", "pattern": "^cmp:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*$" },
        "projectId": { "$ref": "#/$defs/f-projectId" },
        "tenantId": { "$ref": "#/$defs/f-tenantId" },
        "environment": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "statement": { "type": "string" },
        "rationale": { "type": "string" },
        "owner": { "type": "string" },
        "source": { "type": "object" },
        "status": { "enum": ["candidate", "approved", "superseded"] },
        "version": { "type": "integer", "minimum": 1 },
        "supersedes": { "type": "array", "items": { "type": "string" } },
        "supersededBy": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "visibility": { "enum": ["private", "sanitized", "example"] },
        "evidence": { "type": "object" },
        "lifecycle": { "type": "object" },
        "observed": { "type": "object" },
        "diagnostics": { "type": "array" },
        "notes": { "type": "string" },
        "uxIntentRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^uxi:" } },
        "componentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^(uic|cap):" },
              "versionPin": { "type": "string" },
              "variant": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "$comment": "decision",
      "required": ["recordType", "status", "chosen", "decidedBy", "decidedAt"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/f-schemaVersion" },
        "recordType": { "const": "decision" },
        "id": { "type": "string", "pattern": "^dec:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*$" },
        "projectId": { "$ref": "#/$defs/f-projectId" },
