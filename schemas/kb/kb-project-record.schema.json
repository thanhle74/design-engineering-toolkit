        "statement": { "type": "string" },
        "rationale": { "type": "string" },
        "owner": { "type": "string" },
        "source": { "type": "object" },
        "status": { "enum": ["proposed", "accepted", "superseded", "rejected"] },
        "version": { "type": "integer", "minimum": 1 },
        "supersedes": { "type": "array", "items": { "type": "string" } },
        "supersededBy": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "visibility": { "enum": ["private", "sanitized", "example"] },
        "evidence": { "type": "object" },
        "lifecycle": { "type": "object" },
        "observed": { "type": "object" },
        "diagnostics": { "type": "array" },
        "notes": { "type": "string" },
        "optionsConsidered": { "type": "array", "items": { "type": "string" } },
        "chosen": { "type": "string" },
        "decidedBy": { "type": "string" },
        "decidedAt": { "type": "string", "format": "date-time" },
        "scope": { "type": "string" },
        "reversibility": { "enum": ["cheap", "costly", "irreversible"] }
      }
    },
    {
      "$comment": "approval — durability is honest: 'attested' never satisfies approval-demanding gates",
      "required": ["recordType", "status", "approvedBy", "durability", "subject"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/f-schemaVersion" },
        "recordType": { "const": "approval" },
        "id": { "type": "string", "pattern": "^apr:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*$" },
        "projectId": { "$ref": "#/$defs/f-projectId" },
        "tenantId": { "$ref": "#/$defs/f-tenantId" },
