    {
      "$comment": "constraint",
      "required": ["recordType", "status", "strength", "enforcement"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/f-schemaVersion" },
        "recordType": { "const": "constraint" },
        "id": { "type": "string", "pattern": "^con:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*$" },
        "projectId": { "$ref": "#/$defs/f-projectId" },
        "tenantId": { "$ref": "#/$defs/f-tenantId" },
        "environment": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "statement": { "type": "string" },
        "rationale": { "type": "string" },
        "owner": { "type": "string" },
        "source": { "type": "object" },
        "status": { "enum": ["active", "superseded"] },
        "version": { "type": "integer", "minimum": 1 },
        "supersedes": { "type": "array", "items": { "type": "string" } },
        "supersededBy": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "visibility": { "enum": ["private", "sanitized", "example"] },
        "evidence": { "type": "object" },
        "lifecycle": { "type": "object" },
        "observed": { "type": "object" },
        "diagnostics": { "type": "array" },
        "notes": { "type": "string" },
        "strength": { "enum": ["invariant", "default"] },
        "enforcement": { "enum": ["fail-closed", "schema", "ci", "convention"] },
        "scope": { "type": "string" }
      }
    },
    {
      "$comment": "source-document",
      "required": ["recordType", "status", "docKind", "sanitizationStatus"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/f-schemaVersion" },
        "recordType": { "const": "source-document" },
        "id": { "type": "string", "pattern": "^src:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*$" },
        "projectId": { "$ref": "#/$defs/f-projectId" },
        "tenantId": { "$ref": "#/$defs/f-tenantId" },
        "environment": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "statement": { "type": "string" },
        "rationale": { "type": "string" },
        "owner": { "type": "string" },
        "source": { "type": "object" },
        "status": { "enum": ["active", "archived", "superseded"] },
        "version": { "type": "integer", "minimum": 1 },
        "supersedes": { "type": "array", "items": { "type": "string" } },
        "supersededBy": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "visibility": { "enum": ["private", "sanitized", "example"] },
        "evidence": { "type": "object" },
        "lifecycle": { "type": "object" },
        "observed": { "type": "object" },
        "diagnostics": { "type": "array" },
        "notes": { "type": "string" },
        "docKind": { "enum": ["figma-file", "github-issue", "spec", "audit-doc", "decision-record", "state-json", "profile", "ticket"] },
        "locator": { "type": "string" },
        "versionPin": { "type": "string" },
        "classification": { "enum": ["first-party", "client-proprietary", "external"] },
        "sanitizationStatus": { "enum": ["raw", "sanitized", "example-only"] },
        "mayPromoteToPublicToolkit": { "type": "boolean", "$comment": "true requires visibility: example AND sanitizationStatus != raw." }
      }
    }
  ],
  "$defs": {
    "f-schemaVersion": { "const": 1 },
    "f-projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "f-tenantId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "$comment": "Mandatory from record #1 even when only one tenant exists — the query layer is built default-deny from day one." },
    "f-reqKind": { "enum": ["functional", "aesthetic", "content", "legal", "performance", "infrastructure"] },
    "evidence": {
      "type": "object",
      "required": ["proofLevel", "confidence", "uncertainty"],
      "additionalProperties": false,
      "properties": {
        "proofLevel": { "enum": ["DETECTED", "ASSUMED", "TESTED", "UNKNOWN"] },
        "sources": { "type": "array", "items": { "type": "object" } },
        "method": { "type": "string" },
        "confidence": { "enum": ["high", "medium", "low"] },
        "verifiedAt": { "type": ["string", "null"], "format": "date-time" },
        "uncertainty": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "lifecycle": {
      "type": "object",
      "required": ["state", "reviewStatus"],
      "additionalProperties": false,
      "properties": {
        "state": { "enum": ["ACTIVE", "STALE", "INVALIDATED", "ARCHIVED"] },
        "reviewStatus": { "enum": ["unreviewed", "reviewed", "approved"] },
        "reviewedBy": { "type": "string" },
        "reviewRef": { "type": "string" }
      }
    },
    "observed": {
      "type": "object",
      "required": ["scannedAt"],
      "additionalProperties": false,
      "properties": {
        "scannedAt": { "type": "string", "format": "date-time" },
        "inputDigests": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string" }
      }
    }
  }
}
