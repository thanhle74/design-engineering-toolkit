{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/thanhle74/design-engineering-toolkit/main/specs/knowledge-foundation/schemas/kb-ui-component.schema.json",
  "$comment": "Knowledge Foundation draft — KB-2 (UI Component Knowledge) record. Example schema for review. LICENSE-BOUNDED BY STRUCTURE: this schema has no field in which source code, template markup, CSS/JS, asset bytes or license keys may be stored. Licensed packages (Hyvä UI) are recorded as metadata + version-pinned path pointers only. Three UI sources are distinct records distinguished by sourcePackage.kind, linked by relation records (mapsTo/adaptedFrom within the developer-owned class; neighborOf across to Page Builder native) — equivalents are never merged or counted three times.",
  "title": "Knowledge Foundation — KB-2 UI Component record",
  "type": "object",
  "required": ["schemaVersion", "recordType", "id", "sourcePackage", "title", "uxSemantics", "availability", "license", "sourceRef", "evidence", "lifecycle", "observed"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "ui-component" },
    "id": {
      "type": "string",
      "pattern": "^uic:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*$",
      "$comment": "Version-free toolkit id, e.g. 'uic:hyva-ui:banner-a-default', 'uic:secomm-uiwidget:banner-a'. nativeId preserves the upstream identifier ('banner/A-default', 'banner_a')."
    },
    "nativeId": { "type": "string", "$comment": "Upstream identifier exactly as declared: Hyvä UI 'component/variant', widget registry id, PB content type id." },
    "sourcePackage": {
      "type": "object",
      "required": ["kind", "name", "version"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["hyva-ui", "secomm-uiwidget", "page-builder-native", "other"], "$comment": "The three audit sources are first-class kinds; 'other' exists for future sources and must be justified in notes." },
        "name": { "type": "string", "$comment": "Package/module identifier, e.g. 'hyva-themes/hyva-ui'." },
        "version": { "type": "string", "$comment": "Pinned version observed, e.g. '2.8.0'." },
        "locator": { "type": "string", "$comment": "rootAlias-relative pointer to the package root. Never an absolute owner path in shared stores." }
      }
    },
    "title": { "type": "string", "minLength": 1 },
    "uxSemantics": {
      "type": "object",
      "required": ["concept", "description"],
      "additionalProperties": false,
      "properties": {
        "concept": {
          "enum": ["hero", "category-collection", "lookbook", "product-grid", "product-card", "kol-editorial", "slider", "tabs", "accordion", "testimonial", "usp", "navigation", "footer", "search", "modal", "notification", "other"],
          "$comment": "UX-semantic mapping target (issue #7 vocabulary). Non-exhaustive: additive minors only. 'other' requires description."
        },
        "description": { "type": "string" },
        "notSupported": { "type": "array", "items": { "type": "string" }, "$comment": "Explicit: what this component does NOT support. Prevents inventing a component later." }
      }
    },
    "availability": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": { "enum": ["available-upstream", "eligible-for-widget", "imported-runtime", "editable-in-page-builder"], "$comment": "Four distinct states (audit-verified vocabulary). available-upstream implies nothing about use. Use usageLinks to express multi-state reality instead of duplicating records." },
        "eligibility": { "enum": ["b1-implemented", "b2-conditional", "defer", "exclude", "not-applicable"], "$comment": "Eligibility-matrix disposition for widget candidates; reason goes to eligibilityReason." },
        "eligibilityReason": { "type": "string" }
      }
    },
    "usageLinks": {
      "type": "array",
      "$comment": "How this component is actually used by the project — zero or more, never implied by availability.",
      "items": {
        "type": "object",
        "required": ["kind", "refId"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["secomm-widget", "theme-native", "page-builder"] },
          "refId": { "type": "string", "$comment": "ID of the KB-1 capability or theme element providing the runtime rendering." },
          "pointer": { "type": "string", "$comment": "rootAlias-relative path pointer." }
        }
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "$comment": "Variant identifier (metadata), e.g. 'A-default'." },
          "availability": { "enum": ["available-upstream", "eligible-for-widget", "imported-runtime", "editable-in-page-builder", "unknown"] },
          "notes": { "type": "string" }
        }
      }
    },
    "slots": { "type": "array", "items": { "type": "string" }, "$comment": "Named content slots (names only)." },
    "configOptions": {
      "type": "array",
      "$comment": "Configurable option NAMES only. This schema deliberately has no field for option markup, defaults-with-code, or template bodies.",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "kind": { "enum": ["field", "appearance", "variant-prop", "data-source", "behavior"] },
          "notes": { "type": "string" }
        }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interactive": { "type": "boolean" },
        "jsModel": { "enum": ["alpine-csp", "alpine", "none", "unknown"], "$comment": "Alpine CSP build is shipped in the audited theme; the ACTIVE runtime variant is config-driven and may be 'unknown' from file evidence alone." },
        "cssSystem": { "enum": ["tailwind-v4", "tailwind-v3", "other", "unknown"] },
        "breakpoints": { "type": "array", "items": { "type": "integer", "minimum": 320 } },
        "cmsEditable": { "type": "boolean", "$comment": "Whether the component surface is merchant-editable via CMS/Page Builder contexts." },
        "a11yNotes": { "type": "string" }
      }
    },
    "dependencies": { "type": "array", "items": { "type": "string" }, "$comment": "Dependency facts by identifier (plugin/package names), not code." },
    "license": {
      "type": "object",
      "required": ["status", "regime"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["confirmed", "unconfirmed", "incompatible", "not-applicable"] },
        "regime": { "enum": ["commercial", "mit", "ofl", "apache", "proprietary", "not-applicable"] },
        "licenseRef": { "type": "string", "$comment": "Pointer to the license document (path/URL) — never license text or keys." },
        "derivedArtifactPolicy": { "enum": ["metadata-only", "local-use-authorized", "redistribution-prohibited", "unknown"], "$comment": "Hyvä UI records are metadata-only: audit locally with authorized access; never vendor or publish source/templates/assets." }
      }
    },
    "sourceRef": { "$ref": "#/$defs/sourceRef" },
    "evidence": { "$ref": "#/$defs/evidence" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "observed": { "$ref": "#/$defs/observed" },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "notes": { "type": "string" }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "required": ["kind", "locator"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["figma-node", "repo-file", "package", "document", "issue-ref", "db-config"] },
        "locator": { "type": "object", "additionalProperties": { "type": "string" } },
        "lineRange": { "type": "string" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "digest": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["proofLevel", "confidence", "uncertainty"],
      "additionalProperties": false,
      "properties": {
        "proofLevel": { "enum": ["DETECTED", "ASSUMED", "TESTED", "UNKNOWN"] },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "method": { "type": "string" },
        "confidence": { "enum": ["high", "medium", "low"] },
        "verifiedAt": { "type": ["string", "null"], "format": "date-time" },
        "uncertainty": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "lifecycle": {
      "type": "object",
      "required": ["state", "reviewStatus"],
      "additionalProperties": false,
      "properties": {
        "state": { "enum": ["ACTIVE", "STALE", "INVALIDATED", "ARCHIVED"] },
        "reviewStatus": { "enum": ["unreviewed", "reviewed", "approved"] },
        "reviewedBy": { "type": "string" },
        "reviewRef": { "type": "string" }
      }
    },
    "observed": {
      "type": "object",
      "required": ["scannedAt"],
      "additionalProperties": false,
      "properties": {
        "scannedAt": { "type": "string", "format": "date-time" },
        "inputDigests": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string" },
        "sourceRef": { "$ref": "#/$defs/sourceRef" }
      }
    }
  }
}
