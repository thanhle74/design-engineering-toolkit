# Local project configuration and credentials; shared examples live in profiles/*.example.json
.env
.env.*
!.env.example
profiles/*.local.*
profiles/local/
projects/*/local/
*.local.json
*.local.yaml
*.local.yml

# Runtime/editor scratch
node_modules/
dist/
.cache/
.tmp/
tmp/
.DS_Store

# Per-project local notes/overrides
projects/*/*.local.*

# KB store run receipts (timestamped; store content is the committed truth)
kb/tool-run.json

# Local run outputs (pipeline artifacts, fetched assets, local manifests) — never committed
out/

# M4 (issue #19): per-run local configuration and private real-source corpora.
# Everything under these paths is machine-local (explicit root alias values, extract outputs,
# private KB stores) and must NEVER be committed — portability tests assert they stay untracked.
.toolkit/
local-kb/
