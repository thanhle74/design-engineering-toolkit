{
   "compilerOptions": {
      "target": "ES2022",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "outDir": "dist",
      "rootDir": ".",
      "strict": true,
      "noEmitOnError": true,
      "declaration": true,
      "sourceMap": false,
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "skipLibCheck": true,
      "types": ["node"]
   },
   "include": [
      "src/core/**/*.ts",
      "src/modules/figma/**/*.ts",
      "src/modules/magento/**/*.ts",
      "src/modules/knowledge/**/*.ts"
   ],
   "exclude": ["node_modules", "dist", "tests"]
}
