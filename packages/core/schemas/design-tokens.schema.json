{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/thanhle74/design-engineering-toolkit/main/schemas/design-tokens.schema.json",
  "$comment": "Design Engineering Toolkit V1 — design tokens contract. Major version 1. Platform-neutral semantic tokens with primitives, aliases, modes and typography roles. Assumes NO Figma variables/styles exist; provenance records how every value was obtained.",
  "title": "Design Engineering Toolkit — Design Tokens",
  "type": "object",
  "required": ["schemaVersion", "profileId", "generatedAt", "provenance", "modes", "primitive", "semantic"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "profileId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "provenance": { "$ref": "#/$defs/payloadProvenance" },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "default": { "type": "boolean" },
          "description": { "type": "string" }
        }
      }
    },
    "primitive": {
      "type": "object",
      "$comment": "Raw values with no opinion about usage. Semantic layer references these by alias.",
      "additionalProperties": false,
      "properties": {
        "color": { "type": "object", "additionalProperties": { "$ref": "#/$defs/colorToken" } },
        "fontFamily": { "type": "object", "additionalProperties": { "$ref": "#/$defs/fontFamilyToken" } },
        "fontSize": { "type": "object", "additionalProperties": { "$ref": "#/$defs/measureToken" } },
        "fontWeight": { "type": "object", "additionalProperties": { "$ref": "#/$defs/valueToken" } },
        "lineHeight": { "type": "object", "additionalProperties": { "$ref": "#/$defs/measureToken" } },
        "letterSpacing": { "type": "object", "additionalProperties": { "$ref": "#/$defs/measureToken" } },
        "spacing": { "type": "object", "additionalProperties": { "$ref": "#/$defs/measureToken" } },
        "radius": { "type": "object", "additionalProperties": { "$ref": "#/$defs/measureToken" } },
        "breakpoint": { "type": "object", "additionalProperties": { "$ref": "#/$defs/measureToken" } }
      }
    },
    "semantic": {
      "type": "object",
      "$comment": "Usage-named roles. Values are aliases into primitive ({primitive.color.ink-900}) or, where modes differ, a mode map. Curation happens here: roles are chosen, not dumped.",
      "additionalProperties": false,
      "properties": {
        "color": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9][a-z0-9/-]*$" },
          "additionalProperties": { "$ref": "#/$defs/semanticColorToken" }
        },
        "surface": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9][a-z0-9/-]*$" },
          "additionalProperties": { "$ref": "#/$defs/semanticColorToken" }
        }
      }
    },
    "typography": {
      "type": "object",
      "required": ["roles"],
      "additionalProperties": false,
      "properties": {
        "roles": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9][a-z0-9/-]*$" },
          "additionalProperties": { "$ref": "#/$defs/typographyRole" }
        }
      }
    },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "$defs": {
    "payloadProvenance": {
      "type": "object",
      "required": ["sourceManifests"],
      "additionalProperties": false,
      "properties": {
        "sourceManifests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["sourceId", "figmaFileKey"],
            "additionalProperties": false,
            "properties": {
              "sourceId": { "type": "string" },
              "figmaFileKey": { "type": "string" },
              "accessedAt": { "type": "string", "format": "date-time" },
              "auditDocUrl": { "type": "string" }
            }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "sourceRef": {
      "type": "object",
      "required": ["fileKey", "nodeId"],
      "additionalProperties": false,
      "properties": {
        "fileKey": { "type": "string" },
        "nodeId": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
        "page": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "entryProvenance": {
      "type": "object",
      "required": ["class"],
      "additionalProperties": false,
      "properties": {
        "class": { "enum": ["observed", "derived", "illustrative"] },
        "method": { "type": "string" },
        "confidence": { "enum": ["high", "medium", "low"] },
        "sourceRef": { "$ref": "#/$defs/sourceRef" }
      }
    },
    "valueToken": {
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": ["string", "number", "boolean"] },
        "description": { "type": "string" },
        "provenance": { "$ref": "#/$defs/entryProvenance" }
      }
    },
    "measureToken": {
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "$comment": "CSS-length string: '16px', '1.5rem', '0px'." },
        "description": { "type": "string" },
        "provenance": { "$ref": "#/$defs/entryProvenance" }
      }
    },
    "colorToken": {
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
        "description": { "type": "string" },
        "provenance": { "$ref": "#/$defs/entryProvenance" }
      }
    },
    "fontFamilyToken": {
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "$comment": "Exact family name as loaded in Figma, e.g. 'Open Sans'." },
        "fallbacks": { "type": "array", "items": { "type": "string" } },
        "license": { "type": "string" },
        "licenseStatus": { "enum": ["confirmed", "unconfirmed", "incompatible", "not-applicable"] },
        "description": { "type": "string" },
        "provenance": { "$ref": "#/$defs/entryProvenance" }
      }
    },
    "semanticColorToken": {
      "type": "object",
      "required": ["alias"],
      "additionalProperties": false,
      "properties": {
        "alias": { "type": "string", "pattern": "^\\{[^}]+\\}$", "$comment": "Reference to a primitive, e.g. '{primitive.color.ink-900}'." },
        "modes": {
          "type": "object",
          "$comment": "Optional per-mode override: modeId -> alias. Unlisted modes inherit 'alias'.",
          "additionalProperties": { "type": "string", "pattern": "^\\{[^}]+\\}$" }
        },
        "usage": { "type": "string" },
        "contrastPairs": {
          "type": "array",
          "$comment": "Semantic color ids this token must be readable against; consumed by gate G4.",
          "items": { "type": "string" }
        },
        "provenance": { "$ref": "#/$defs/entryProvenance" }
      }
    },
    "typographyRole": {
      "type": "object",
      "required": ["fontFamily", "weight", "size", "lineHeight"],
      "additionalProperties": false,
      "properties": {
        "fontFamily": { "type": "string", "pattern": "^\\{[^}]+\\}$", "$comment": "Alias, e.g. '{primitive.fontFamily.display-serif}'." },
        "weight": { "type": "string", "pattern": "^\\{[^}]+\\}$" },
        "size": {
          "type": "object",
          "required": ["base"],
          "additionalProperties": false,
          "properties": {
            "base": { "type": "string", "pattern": "^\\{[^}]+\\}$" },
            "byBreakpoint": {
              "type": "object",
              "additionalProperties": { "type": "string", "pattern": "^\\{[^}]+\\}$" },
              "$comment": "breakpoint px value as key, e.g. {\"390\": \"{primitive.fontSize.56}\"}."
            }
          }
        },
        "lineHeight": { "type": "string", "pattern": "^\\{[^}]+\\}$" },
        "letterSpacing": { "type": "string", "pattern": "^\\{[^}]+\\}$" },
        "textTransform": { "enum": ["none", "uppercase", "lowercase", "capitalize"] },
        "usage": { "type": "string" },
        "provenance": { "$ref": "#/$defs/entryProvenance" }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string" },
        "sourceRef": { "$ref": "#/$defs/sourceRef" }
      }
    }
  }
}
